  },
  "responseTemplates": {},
  "resources": [],
  "properties": [
    {
      "key": "databricks_upstream_token",
      "value": "",
      "encrypted": false,
      "dynamic": false,
      "_redacted_by": "tests/t16_mcp_route.py",
      "_redacted_because": "The live API carries the filled credential. Writing it to evidence/ would put a working Databricks PAT in a committed artifact (\u00a73.6). check_secret_hygiene caught exactly this on 2026-10-21.",
      "_refill_with": "python3 scripts/05_import_gravitee_api.py --definition gravitee/generated/api-m1-ai-gateway.json, which fills this property from DATABRICKS_TOKEN and CONFIRMS it landed on the server before reporting success."
    }
  ],
