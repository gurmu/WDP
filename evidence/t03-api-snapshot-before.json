          ]
        }
      ],
      "request": [
        {
          "name": "Require bearer token present",
          "enabled": true,
          "policy": "policy-assign-attributes",
          "configuration": {
            "scope": "REQUEST",
            "attributes": [
              {
                "name": "has-bearer",
                "value": "{#request.headers['Authorization'] != null && #request.headers['Authorization'].startsWith('Bearer ')}"
              }
            ]
          }
        },
        {
          "name": "Inject correlation ID",
          "enabled": true,
          "policy": "transform-headers",
          "configuration": {
            "addHeaders": [
              {
                "name": "X-Correlation-Id",
                "value": "{#request.id}"
              }
            ],
            "scope": "REQUEST"
          }
        },
        {
          "name": "CIDR allow-list (agency IP ranges)",
          "description": "CONOPS 3.1 - IP allow-listing. DISABLED for this recipient by design.",
          "enabled": false,
          "policy": "ip-filtering",
