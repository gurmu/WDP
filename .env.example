# TEMPLATE ONLY -- copy to .env and fill in real values there.
#
#   cp .env.example .env && chmod 0600 .env
#
# This is the ONLY config file in the repo that gets committed. Every
# value here must stay a <placeholder>. Never copy .env back over this
# file, and never paste either file's contents into a chat window.
#
# Enforced by scripts/check_secret_hygiene.py, which refuses to pass if
# anything here looks like a live credential, and by the pre-commit hook
# in scripts/hooks/pre-commit, which refuses the commit.

# --- Databricks workspace (Free Edition for the quick capability check, or
#     the 14-day Premium/AWS trial for the full provider-side flow -- see
#     docs/00-services-setup-guide.md) ---
# No trailing slash on hosts.
DATABRICKS_HOST=https://<workspace-id>.cloud.databricks.com
DATABRICKS_TOKEN=<pat-from-settings-developer-access-tokens>
UC_METASTORE_CATALOG=awoz1227_demo
UC_SCHEMA=opensharing_test
UC_TABLE=test_dataset

# --- Gravitee (local docker-compose stack, no account needed) ---
# admin/admin is the stack's own default on localhost, not a secret.
GRAVITEE_MGMT_API_URL=http://localhost:8083
GRAVITEE_MGMT_USER=admin
GRAVITEE_MGMT_PASSWORD=admin
GRAVITEE_GATEWAY_EDGE_URL=http://localhost:8082/delta-sharing
GRAVITEE_STORAGE_PROXY_URL=http://localhost:8082/storage-proxy

# --- Optional: only needed if your Databricks trial provisions AWS
#     resources into your own account (S3 bucket + IAM role for the
#     Unity Catalog metastore). Leave blank if you're on Free Edition
#     or a Databricks-managed trial. ---
#
# LEAVE THESE BLANK OR DELETE THEM -- do not "fill them in" with
# placeholder text. A blank AWS_PROFILE here used to reach botocore as
# AWS_PROFILE="", which it reads as a profile whose NAME is the empty
# string, and the whole of scripts/10 died with
#   ProfileNotFound: The config profile () could not be found
# naming neither this file nor the variable. scripts/10 now skips blank
# values on load for exactly that reason (docs/11 B-10b). Any other
# script that sources this file directly (`set -a; . .env`) does NOT
# have that protection, so an exported empty AWS_PROFILE can still bite
# there.
AWS_REGION=
AWS_PROFILE=

# --- Second metastore for Databricks-to-Databricks sharing ------------
# A SECOND Databricks account, registered to a different email, giving a
# second Unity Catalog METASTORE. Confirmed distinct on 2026-10-18:
# 48cda780-... (primary) vs 8875961b-... (second). Required for T-19
# (D2D ingress) and the proposed E-2 egress test.
#
# A second CATALOG in the same workspace does not work here. D2D names
# its far side by a sharing identifier cloud:region:<metastore-uuid>, so
# the far side must be a metastore.
#
# GLOVASHU_CATALOG must name a catalog UNIQUE to that workspace. Not
# `workspace`, `default`, `samples`, `system`, `main` or
# `hive_metastore` -- every workspace has those, and a probe matching on
# one of them cannot tell the two accounts apart. The probe now rejects
# these names outright rather than returning a false SAME_METASTORE.
GLOVASHU_HOST=https://<second-workspace-id>.cloud.databricks.com
GLOVASHU_TOKEN=<pat-from-the-second-account>
GLOVASHU_CATALOG=<catalog-name-unique-to-that-workspace>
UC_SCHEMA_GLOVASHU=default

# --- Open-source OpenSharing provider (D2O far side, T-20 / T-23) -----
# This is a RUNNING DELTA SHARING SERVER, not a source-code location.
# It must answer the Delta Sharing REST protocol:
#
#   GET <OSS_PROVIDER_URL>/shares   ->   {"items": [...]}
#
# A GitHub URL cannot serve that -- GitHub hosts the server's source,
# it does not run the server. Use the delta-io/delta-sharing reference
# server from the local docker-compose stack and point this at it.
#
# OSS_PROVIDER_TOKEN is a bearer token that THAT server issues, not a
# GitHub PAT. A GitHub PAT will be rejected by it.
# Host port 8086, NOT 8080: 8080 is already occupied on the build
# machine and 8082-8085 belong to the Gravitee stack. The container
# still listens on 8080 internally, which is what the rendered server
# config's `port:` key refers to.
OSS_PROVIDER_URL=http://localhost:8086/delta-sharing
OSS_PROVIDER_TOKEN=<bearer-token-issued-by-your-own-provider>
OSS_PROVIDER_PROFILE=_secrets/oss-provider-credential.json

# --- Object storage behind the D2O provider (MANDATORY) --------------
# Not an optimisation. The Delta Sharing server has no local-filesystem
# implementation: /query answers with PRE-SIGNED URLS, which a local
# path cannot have, so a file:// table fails with "File system class
# org.apache.hadoop.fs.LocalFileSystem is not supported" and reaches the
# client as a bare HTTP 500. Recorded as docs/11 B-8.
#
# The store is a LOCAL STAND-IN for the client's S3/ADLS -- same S3A
# client, same pre-signed URL mechanics, different endpoint. These keys
# are named for the ROLE, not for the product: MinIO was withdrawn from
# distribution mid-build (docs/11 B-10) and a product-named variable
# would now be configuring a different vendor's server.
#
# ONE pair of credentials configures BOTH sides. docker-compose.yml
# passes these to the store as its access key AND to
# delta_sharing_server as AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY,
# which the S3A stack picks up via the environment provider named in
# oss-provider/core-site.xml. That is why core-site.xml carries no keys
# and can be tracked in git.
#
# Generate the secret rather than inventing one:
#     python3 -c "import secrets; print(secrets.token_urlsafe(24))"
OBJECTSTORE_ACCESS_KEY=awoz1227
OBJECTSTORE_SECRET_KEY=<generate-me>

# Bucket for the shared table. Created by scripts/10_setup_oss_provider.py.
OSS_PROVIDER_BUCKET=awoz-opensharing

# HOST-side endpoint, used by the setup script to write the table and by
# the probe acting as a consumer. The SERVER uses
# http://objectstore:8000 from oss-provider/core-site.xml instead, and
# that container-side name is what ends up inside the signature of every
# pre-signed URL -- which is why a consumer needs
#     127.0.0.1 objectstore
# in /etc/hosts, and why the published port must equal the internal one.
# The two values name the same bytes and are not interchangeable.
OBJECTSTORE_HOST_ENDPOINT=http://localhost:8000

# --- Optional: iceberg route on the gateway (see docs/12 Sec 12.8) ---
# Defaults to <GRAVITEE_GATEWAY_EDGE_URL>/iceberg if unset.
GRAVITEE_GATEWAY_ICEBERG_URL=
